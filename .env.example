# =============================================================================
# CRM-CAVALCANTI — Env vars template (uso local + produção Vercel)
# =============================================================================
#
# Este arquivo é a fonte da verdade das env vars usadas pelo app. Nunca contém
# secrets reais — apenas placeholders.
#
# Uso:
#   1. Local:   cp .env.example .env.local  → preencher
#   2. Vercel:  copiar cada var pro dashboard Vercel → Settings → Environment
#   3. Staging: ver .env.staging.example (subset separado, com prefixo STAGING_)
#
# Convenções:
#   - NEXT_PUBLIC_* = expostas ao browser (safe pra client bundle)
#   - Sem NEXT_PUBLIC_ = apenas server-side (nunca no browser)

# -----------------------------------------------------------------------------
# SUPABASE — obrigatórias (app inteiro depende)
# -----------------------------------------------------------------------------
# Dashboard: https://supabase.com/dashboard/project/<ref>/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1...
# Service Role — NUNCA expor ao client. Usado em server actions/services
# que rodam com bypass de RLS (import 'server-only' guard nos módulos).
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1...

# -----------------------------------------------------------------------------
# APP — URL pública (usada em emails, OG meta, links de invite)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://crm-cavalcanti.vercel.app

# -----------------------------------------------------------------------------
# hCAPTCHA — opcional (habilita CAPTCHA no login se site key setada)
# -----------------------------------------------------------------------------
# Deixe VAZIO em local pra pular CAPTCHA nos testes.
# Em prod, configurar site+secret em Supabase Auth e setar aqui.
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=

# -----------------------------------------------------------------------------
# EMAIL — provider pluggable (mock em local, resend em prod)
# -----------------------------------------------------------------------------
# Values: mock | resend
EMAIL_PROVIDER=mock
# Sender address (formato "Nome <endereço>")
EMAIL_FROM=Nogma Gestor de Obras <no-reply@nogmacorp.com.br>
# Resend API key — só necessária quando EMAIL_PROVIDER=resend
# https://resend.com/api-keys
RESEND_API_KEY=

# -----------------------------------------------------------------------------
# IA CLASSIFIER — provider pluggable (Fase 8 pending)
# -----------------------------------------------------------------------------
# Values: mock | anthropic (Claude Haiku 4.5 recomendado)
IA_PROVIDER=mock
# Anthropic API key — só necessária quando IA_PROVIDER=anthropic
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------------
# WHATSAPP (UAZAPI) — Fase 8 pending, config no n8n/proxy
# -----------------------------------------------------------------------------
# Secret usado no HMAC do webhook inbound /api/webhooks/uazapi.
# Gerar com: openssl rand -hex 32
WEBHOOK_HMAC_SECRET=

# -----------------------------------------------------------------------------
# CRON — Bearer token pra endpoints /api/cron/*
# -----------------------------------------------------------------------------
# Vercel Cron manda header "Authorization: Bearer <CRON_SECRET>".
# Gerar com: openssl rand -hex 32
CRON_SECRET=

# =============================================================================
# TESTES E2E (Playwright) — só necessárias pra rodar `pnpm test:e2e`
# =============================================================================

# Credenciais do usuário de teste (criar em staging via Supabase Dashboard)
AUTH_TEST_EMAIL=admin@nogmacorp.com.br
AUTH_TEST_PASSWORD=

# URL do target dos testes (default: localhost:3000)
PLAYWRIGHT_BASE_URL=http://localhost:3000

# Rodar contra staging (usa STAGING_* vars do .env.staging).
# Values: staging | (unset = local)
PLAYWRIGHT_ENV=

# Set to 1 pra pular guard de hCaptcha nos E2E (só CI-friendly).
PLAYWRIGHT_ALLOW_HCAPTCHA=

# =============================================================================
# SCRIPTS DE OPERAÇÃO — só necessárias pra rodar scripts/*.mjs
# =============================================================================

# Supabase Personal Access Token (Dashboard → Account → Access Tokens)
# Usado por scripts/apply-migrations-staging.mjs e provisioning.
# https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=sbp_...

# Vercel API token (Dashboard → Settings → Tokens)
# Usado por scripts/setup-vercel-staging-env.mjs.
# https://vercel.com/account/tokens
VERCEL_TOKEN=
VERCEL_PROJECT_ID=prj_...
VERCEL_TEAM_ID=team_...
