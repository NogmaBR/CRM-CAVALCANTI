# =============================================================================
# CRM-CAVALCANTI — Credenciais STAGING (nunca commitar; já no .gitignore)
# =============================================================================
#
# Este arquivo é copiado + preenchido depois de provisionar staging Supabase.
# Uso: cp .env.staging.example .env.staging → preencher valores → uso:
#   pnpm test:e2e:staging          # rodar E2E contra staging
#   pnpm staging:apply-migrations  # aplica migrations no staging DB
#   pnpm staging:setup-vercel      # provisiona env vars Vercel Preview
#
# Reference: docs/operacao/fase-15-staging.md

# ---------- SUPABASE STAGING ----------
STAGING_SUPABASE_PROJECT_REF=
STAGING_SUPABASE_URL=https://<ref>.supabase.co
STAGING_SUPABASE_ANON_KEY=
STAGING_SUPABASE_SERVICE_ROLE_KEY=
STAGING_SUPABASE_DB_PASSWORD=

# Access Token (mesmo do prod serve — reusa .env.local SUPABASE_ACCESS_TOKEN)
STAGING_SUPABASE_ACCESS_TOKEN=sbp_...

# ---------- AUTH TEST USER STAGING ----------
# Criar via Supabase Auth quando staging tiver hCaptcha desabilitado
AUTH_TEST_EMAIL=admin@nogmacorp.com.br
AUTH_TEST_PASSWORD=

# ---------- PLAYWRIGHT ----------
# Overrides das vars normais quando rodando com PLAYWRIGHT_ENV=staging
NEXT_PUBLIC_SUPABASE_URL=${STAGING_SUPABASE_URL}
NEXT_PUBLIC_SUPABASE_ANON_KEY=${STAGING_SUPABASE_ANON_KEY}
SUPABASE_SERVICE_ROLE_KEY=${STAGING_SUPABASE_SERVICE_ROLE_KEY}

# Base URL — quando rodando local com staging DB usa localhost;
# quando rodando em CI contra Preview URL, o CI seta PLAYWRIGHT_BASE_URL
PLAYWRIGHT_BASE_URL=http://localhost:3000
