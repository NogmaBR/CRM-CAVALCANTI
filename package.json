{
  "name": "crm-nogma",
  "private": true,
  "version": "0.0.1",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "start": "pnpm --filter web start",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter web test:e2e",
    "test:e2e:install": "pnpm --filter web exec playwright install --with-deps chromium",
    "test:e2e:ui": "pnpm --filter web exec playwright test --ui",
    "e2e:cleanup": "node scripts/e2e-cleanup.mjs",
    "db:types": "pnpm --filter @nogma/db gen-types"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  }
}
